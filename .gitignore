# Python
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
.env
*.egg-info/
.eggs/
dist/
build/

# IDE / OS
.idea/
.vscode/
.DS_Store

# Analysis outputs
# The glob matters: analysis_results_v2/, _v3.6/, _qc_max/ and friends
# accumulated as untracked clutter because only the bare name was listed.
analysis_results*/
comparison_results/

# Re-analysis runs (tools/reanalyze.py) — xlsx/pdf reports plus manifest.
# The manifest is worth keeping when a run is a reference point; commit
# it explicitly with `git add -f` rather than tracking the whole tree.
reanalysis/

# Transfer artifacts. *.dat is here because git bundles were once renamed
# to .dat to slip past the *.bundle rule.
*.patch
*.diff
*.dat

# Signal images (local reference data)
SIGNAL IMAGES/

# Large local datasets (keep repo code-only)
µECG-Pharma Calibration - EXCEL DATA/

# CDISC SEND export output
cdisc_send_output/

# Git bundles (transfer artifacts)
*.bundle

# ── Added Oct 2026 (repo hygiene) ──
# Stale copy of .git made to work around a lock on the mounted filesystem.
.git-tmp-copy/
# Local study folders and raw datasets (22 GB) — never in the repo.
studio_MR/
Experiments-Toxicol.Science/
# Scratch diagnostics (PNG plots, forks of core modules used for one-off
# investigations). Anything worth keeping goes under docs/ or tests/.
diagnostics/
send_export/
# Loose data/plots at repo root
/*.csv
/*.png
# pytest
.pytest_cache/
pytest-cache-files-*/
# Executed one-off commit scripts
SPRINT*_COMMIT_BLOCK.sh
